# ──────────────────────────────────
# Simple Stock Agent v1 — 配置模板
# ──────────────────────────────────
# 使用方式:
#   1. 复制这个文件: cp .env.example .env
#   2. 填入你的 Alpaca API Key
#   3. 注意: .env 不要传到 GitHub!
#
# 注册 Alpaca: https://alpaca.markets (选 Paper Trading, 免费)

ALPACA_API_KEY=pk_your_actual_api_key_here
ALPACA_SECRET_KEY=your_actual_secret_key_here
